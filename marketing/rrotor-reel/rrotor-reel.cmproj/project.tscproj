  "parameters": {
   "toc": {
    "type": "string",
    "keyframes": [
     {
      "endTime": 0,
      "time": 0,
      "value": "Scene hook",
      "duration": 0
     },
     {
      "endTime": 211680000,
      "time": 211680000,
      "value": "Claude builds you a dashboard, a tool, a job. Then what?",
      "duration": 0
     },
     {
      "endTime": 1975680000,
      "time": 1975680000,
      "value": "rrotor is where it goes to run.",
      "duration": 0
     },
     {
      "endTime": 3528000000,
      "time": 3528000000,
      "value": "Scene session",
      "duration": 0
     },
     {
      "endTime": 3810240000,
      "time": 3810240000,
      "value": "One session: a page, a command-line tool, a scheduled program.",
      "duration": 0
     },
     {
      "endTime": 6279840000,
      "time": 6279840000,
      "value": "Three things. One contract.",
      "duration": 0
     },
     {
      "endTime": 9172800000,
      "time": 9172800000,
      "value": "Scene race",
      "duration": 0
     },
     {
      "endTime": 9384480000,
      "time": 9384480000,
      "value": "Each one is deployed by commit.",
      "duration": 0
     },
     {
      "endTime": 11571840000,
      "time": 11571840000,
      "value": "Runs in a sandbox that reaches only the hosts it names.",
      "duration": 0
     },
     {
      "endTime": 13970880000,
      "time": 13970880000,
      "value": "Waits for a person, where you said so.",
      "duration": 0
     },
     {
      "endTime": 16369920000,
      "time": 16369920000,
      "value": "And lands at your own host. Through Glyphh: nothing.",
      "duration": 0
     },
     {
      "endTime": 19051200000,
      "time": 19051200000,
      "value": "Scene apps",
      "duration": 0
     },
     {
      "endTime": 19262880000,
      "time": 19262880000,
      "value": "An app: the page Claude wrote, published to your people.",
      "duration": 0
     },
     {
      "endTime": 21661920000,
      "time": 21661920000,
      "value": "A reviewer approves it. Only the roles you named can open it.",
      "duration": 0
     },
     {
      "endTime": 24696000000,
      "time": 24696000000,
      "value": "Scene clis",
      "duration": 0
     },
     {
      "endTime": 24907680000,
      "time": 24907680000,
      "value": "A CLI: a tool Claude drives without touching your machine, as the person who asked.",
      "duration": 0
     },
     {
      "endTime": 27659520000,
      "time": 27659520000,
      "value": "Claude Code, Codex, Gemini, Cursor, Grok and Copilot come built in.",
      "duration": 0
     },
     {
      "endTime": 30340800000,
      "time": 30340800000,
      "value": "Scene programs",
      "duration": 0
     },
     {
      "endTime": 30552480000,
      "time": 30552480000,
      "value": "A program: its secrets in the vault, its schedule fired by the runtime.",
      "duration": 0
     },
     {
      "endTime": 32880960000,
      "time": 32880960000,
      "value": "Its approvals, yours.",
      "duration": 0
     },
     {
      "endTime": 35280000000,
      "time": 35280000000,
      "value": "Scene end",
      "duration": 0
     },
     {
      "endTime": 35562240000,
      "time": 35562240000,
      "value": "Free on one node. Ask Claude to install rrotor.",
      "duration": 0
     },
     {
      "endTime": 37537920000,
      "time": 37537920000,
      "value": "glyphh dot ai, slash products, slash rrotor.",
      "duration": 0
     }
    ]
   }
